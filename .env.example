# Streetrack mobile — runtime configuration template
#
# 1. Copy this file to `.env` (gitignored).
# 2. Replace each <placeholder> with the real value.
# 3. Restart `expo start` after changes — env vars are read at build time
#    (see TECHSPEC §6.2). A misconfigured value throws at app boot
#    via src/config.ts (zod-validated, see TECHSPEC §6.3).
#
# All four values are REQUIRED. The app will refuse to launch otherwise.

# Auth0 tenant — same tenant as the web app (streetrack-fe).
# Find these under Auth0 Dashboard → Applications → <Native app> → Settings.
AUTH0_DOMAIN=<your-tenant>.auth0.com
AUTH0_CLIENT_ID=<native-app-client-id>

# Auth0 API identifier (audience). Same value the web app uses;
# defined under Auth0 Dashboard → APIs → <streetrack-be API> → Identifier.
AUTH0_AUDIENCE=https://<your-api-identifier>

# streetrack-be base URL (no trailing slash). Per-environment, see TECHSPEC §6.1:
#   development → local or dev backend
#   preview     → staging backend
#   production  → prod backend
API_BASE_URL=https://<your-streetrack-be-host>
